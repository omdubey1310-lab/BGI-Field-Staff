<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#EEF1F5">

        <!-- Title -->
        <TextView
            android:id="@+id/tvAppName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="LokAwaaz Worker"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="#2C2C2C"
            android:layout_marginTop="40dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <!-- Illustration -->
        <ImageView
            android:id="@+id/imgIllustration"
            android:layout_width="180dp"
            android:layout_height="140dp"
            android:src="@drawable/road_worker"
            android:scaleType="fitCenter"
            android:layout_marginTop="16dp"
            app:layout_constraintTop_toBottomOf="@id/tvAppName"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <!-- Card -->
        <androidx.cardview.widget.CardView
            android:id="@+id/cardLogin"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_margin="20dp"
            app:cardCornerRadius="20dp"
            app:cardElevation="8dp"
            app:cardBackgroundColor="#FFFFFF"
            app:layout_constraintTop_toBottomOf="@id/imgIllustration"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <!-- Login Title -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Worker Login"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="#000000"
                    android:layout_gravity="center"
                    android:layout_marginBottom="16dp"/>

                <!-- Email -->
                <EditText
                    android:id="@+id/etEmail"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Enter your work email"
                    android:textColor="#000000"
                    android:textColorHint="#888888"
                    android:padding="14dp"
                    android:background="@drawable/bg_input"
                    android:drawableStart="@android:drawable/ic_dialog_email"
                    android:drawablePadding="10dp"/>

                <!-- Password -->
                <EditText
                    android:id="@+id/etPassword"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Enter your password"
                    android:textColor="#000000"
                    android:textColorHint="#888888"
                    android:inputType="textPassword"
                    android:padding="14dp"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_input"
                    android:drawableStart="@android:drawable/ic_lock_lock"
                    android:drawablePadding="10dp"/>

                <!-- Name -->
                <EditText
                    android:id="@+id/etName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Full Name"
                    android:visibility="gone"
                    android:textColor="#000000"
                    android:textColorHint="#888888"
                    android:padding="14dp"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_input"/>

                <!-- Worker Type -->
                <Spinner
                    android:id="@+id/spinnerWorkerType"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:visibility="gone"
                    android:layout_marginTop="12dp"/>

                <!-- Department -->
                <Spinner
                    android:id="@+id/spinnerDepartment"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:visibility="gone"
                    android:layout_marginTop="12dp"/>

                <!-- Aadhaar Upload -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="12dp"
                    android:weightSum="2">

                    <Button
                        android:id="@+id/btnCaptureAadhaar"
                        android:layout_width="0dp"
                        android:layout_height="50dp"
                        android:layout_weight="1"
                        android:text="Capture Aadhar"
                        android:textAllCaps="false"
                        android:layout_marginEnd="4dp"
                        android:textColor="@android:color/white"
                        android:background="@drawable/bg_button"
                        android:visibility="gone"/>

                    <Button
                        android:id="@+id/btnUploadAadhaar"
                        android:layout_width="0dp"
                        android:layout_height="50dp"
                        android:layout_weight="1"
                        android:text="Upload Aadhar"
                        android:textAllCaps="false"
                        android:layout_marginStart="6dp"
                        android:textColor="@android:color/white"
                        android:background="@drawable/bg_button"
                        android:visibility="gone"/>

                </LinearLayout>

                <!-- Selfie Upload -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="12dp"
                    android:weightSum="2">

                    <Button
                        android:id="@+id/btnCaptureSelfie"
                        android:layout_width="0dp"
                        android:layout_height="50dp"
                        android:layout_weight="1"
                        android:text="Capture Selfie"
                        android:textAllCaps="false"
                        android:layout_marginEnd="6dp"
                        android:textColor="@android:color/white"
                        android:background="@drawable/bg_button"
                        android:visibility="gone"/>

                    <Button
                        android:id="@+id/btnUploadSelfie"
                        android:layout_width="0dp"
                        android:layout_height="50dp"
                        android:layout_weight="1"
                        android:text="Upload Selfie"
                        android:textAllCaps="false"
                        android:layout_marginStart="6dp"
                        android:textColor="@android:color/white"
                        android:background="@drawable/bg_button"
                        android:visibility="gone"/>

                </LinearLayout>

                <!-- Toggle -->
                <TextView
                    android:id="@+id/txtToggleMode"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="New Worker? Register Here"
                    android:textColor="#3F8CFF"
                    android:textStyle="bold"
                    android:layout_gravity="center"
                    android:layout_marginTop="14dp"/>

                <!-- Login/Register Button -->
                <Button
                    android:id="@+id/btnLogin"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:text="Login"
                    android:textAllCaps="false"
                    android:textColor="@android:color/white"
                    android:layout_marginTop="20dp"
                    android:background="@drawable/bg_button"/>

                <!-- Forgot Password -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Forgot Password?"
                    android:textSize="12sp"
                    android:textColor="#3F8CFF"
                    android:layout_gravity="center"
                    android:layout_marginTop="12dp"/>

            </LinearLayout>

        </androidx.cardview.widget.CardView>

        <!-- Bottom Text -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Don't have an account? Contact Administrator"
            android:textSize="12sp"
            android:textColor="#555555"
            android:layout_marginBottom="24dp"
            app:layout_constraintTop_toBottomOf="@id/cardLogin"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

    </androidx.constraintlayout.widget.ConstraintLayout>

</ScrollView>